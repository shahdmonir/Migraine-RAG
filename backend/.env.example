# هاتي المفتاح ده من console.anthropic.com بعد ما تعملي حساب
ANTHROPIC_API_KEY=your_api_key_here

# اسم الموديل - سيب زي ما هو إلا لو عندك سبب تغييره
CLAUDE_MODEL=claude-sonnet-5

# اسم ملف الـ PDF (لازم يكون موجود جوه مجلد data)
PDF_FILENAME=source.pdf

# اسم المصدر اللي هيظهر في الـ citation
SOURCE_LABEL=NICE CG150 - Headaches in over 12s

# عدد الـ chunks اللي هترجع من البحث
TOP_K=5
